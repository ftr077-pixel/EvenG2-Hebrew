# Deepgram API key for real-time Hebrew speech recognition
# Get one at https://console.deepgram.com
# Copy this file to .env and fill in your key
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API key for AI meeting summarization (claude-opus-4-6)
# Get one at https://console.anthropic.com
# Optional: if omitted, sessions are saved without AI summaries
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
