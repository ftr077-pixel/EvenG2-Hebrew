# Deepgram API key for real-time Hebrew speech recognition
# Get one at https://console.deepgram.com
# Copy this file to .env and fill in your key
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenRouter API key — used for both:
#   • Hebrew → Russian live translation (google/gemini-2.5-flash)
#   • Post-session AI meeting summary    (google/gemini-2.5-flash)
# Get one at https://openrouter.ai/keys
# Optional: if omitted, translations and summaries are skipped.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
